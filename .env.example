# Application
APP_NAME=FloodGuard Edge
APP_ENV=development
LOG_LEVEL=INFO

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT topics
MQTT_TELEMETRY_TOPIC=city/drainage/+/+/telemetry
MQTT_HEARTBEAT_TOPIC=city/drainage/+/+/heartbeat
MQTT_RISK_TOPIC=city/drainage/+/risk
MQTT_ALERT_TOPIC=city/drainage/+/alerts

# Fog configuration
FOG_NODE_ID=fog-node-001
FOG_ZONE_ID=dublin-zone-01
LOCAL_DATABASE_PATH=data/floodguard.db

# Backend API
API_HOST=127.0.0.1
API_PORT=8000
